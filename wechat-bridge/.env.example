# 复制成 .env 再填自己的值：Copy-Item .env.example .env
# .env 已被 .gitignore 忽略，不会被提交，也不要贴给别人。

# ── 必填 ──────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-你的key

# ── 常用可选项（不写就用注释里的默认值）────────────────
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DSH_CWD=C:\path\to\your\workspace        # 默认工作区；微信里也能用 /ws 临时切
# DSH_PERMISSION_MODE=danger-full-access      # 或 workspace-write（限制在工作区内）
# DSH_MODEL=deepseek-v4-flash
# DSH_PROVIDER=deepseek-official
# WECHAT_LEAN_PROFILE=1                       # 1=瘦身档(11.6k 提示词)，0=完整档(38.4k，含截图工具)
# WECHAT_ALLOW=                               # 允许的微信用户 ID，逗号分隔；留空则第一个发消息的人自动配对
# WECHAT_MAX_CHARS=1200                       # 单条微信消息分片长度
# WECHAT_TOKEN_FOOTER=1                       # 回复末尾附 token 消耗
# WECHAT_PREPROCESS=1                         # 本地预处理默认开关
