<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!--
            图标包入口 Activity。
            本模块没有任何 Kotlin/Java 源码，因此直接使用框架自带的
            android.app.Activity（public、非抽象、有默认构造函数，框架可以正常实例化并启动），
            省掉一个源文件。

            下面这个 intent-filter 是启动器识别「图标包」的唯一依据：
            org.adw.launcher.THEMES 是关键 action（ADW / Nova / Smart Launcher /
            Lawnchair / Apex / GO 等都会查询它）。多写几个 action 是合法的，
            intent-filter 的语义是「任一 action 命中即可」，可以覆盖更多启动器。
        -->
        <activity
            android:name="android.app.Activity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <action android:name="com.gau.go.launcherex.theme" />
                <action android:name="com.novalauncher.THEME" />
                <action android:name="com.anddoes.launcher.THEME" />
                <action android:name="com.teslacoilsw.launcher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
